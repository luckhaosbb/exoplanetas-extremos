# Porta do Servidor Express (definida automaticamente por plataformas como Render)
PORT=3001

# Ambiente de Execução (development / production)
NODE_ENV=production

# Chave Secreta do Servidor para Assinatura Criptográfica HMAC-SHA256 (NFT-like Provenance)
SERVER_SECRET_KEY=SUA_CHAVE_SECRETA_COSMIC_ARCHIVE_AQUI

# Conexão com o PostgreSQL (Render PostgreSQL, Neon, Supabase, etc.)
# Exemplo nuvem: postgresql://user:password@hostname:5432/database?sslmode=require
# Se deixado em branco, o sistema ativa automaticamente o fallback local persistente em JSON (server/data/).
DATABASE_URL=
