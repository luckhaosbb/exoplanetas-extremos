# ==============================================================================
# OBSERVATÓRIO DE EXOPLANETAS EXTREMOS • TEMPLATE DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha suas próprias credenciais.
# NUNCA comite o arquivo .env no Git!
# ==============================================================================

# Porta do Servidor Express (atribuída automaticamente no Render)
PORT=3001

# Ambiente de Execução (development / production)
NODE_ENV=production

# Chave Secreta do Servidor para Assinatura Criptográfica HMAC-SHA256 (NFT-like Provenance)
# Use uma string longa e aleatória em produção
SERVER_SECRET_KEY=change_this_to_a_long_random_secret_string_in_production

# Conexão com o PostgreSQL (Render PostgreSQL, Neon, Supabase, etc.)
# Exemplo nuvem: postgresql://user:password@hostname:5432/database?sslmode=require
# Se deixado em branco, o sistema ativa automaticamente o fallback local persistente em JSON (server/data/).
DATABASE_URL=

# Data Oficial de Lançamento (Formato: YYYY-MM-DD no Horário de Brasília UTC-3)
LAUNCH_DATE=2026-09-28

# Controle do Modo Pré-Estreia (opcional - por padrão calcula dinamicamente contra LAUNCH_DATE)
# COMING_SOON=false

# Senha de Autenticação do Painel Confidencial do Autor (Curadoria Semanal)
# DEFINA UMA SENHA FORTE PRIVADA NO SEU AMBIENTE. NUNCA DEIXE NO FRONT-END!
CURADORIA_PASSWORD=change_this_to_your_secure_password_for_curator_dashboard

# ==============================================================================
# PROVEDORES DE IA DE IMAGEM (CASCADE FALLBACK CHAIN - SELEÇÃO E REDUNDÂNCIA)
# ==============================================================================

# ROTA 1: SiliconFlow / SiliconCloud (FLUX.1-schnell via GPU Cluster)
# Cadastro em: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ROTA 2: Together AI (FLUX.1.1-pro nativo 768x1024)
# Obtenha em: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=your_together_api_key_here

# ROTA 3: Cloudflare Workers AI (10.000 Neurons/dia Gratuitos - FLUX.1-schnell)
# Obtenha seu Account ID e API Token com permissão "Workers AI" em: https://dash.cloudflare.com/
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ROTA 4: Google Cloud / Google AI Studio (Imagen 3 / Gemini Image)
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here
